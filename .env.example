DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Upstash Redis — Vercel integration supplies KV_REST_API_URL and KV_REST_API_TOKEN.
# Namespaces are automatically separate for staging and production. Only override
# RATE_LIMIT_NAMESPACE for an isolated local/test deployment.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# RATE_LIMIT_NAMESPACE=isolated-test
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only — for user_usage increments when RLS blocks anon JWT updates (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SMTP — Hostinger (port 587, STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_USER=info@layah.in
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=info@layah.in
# Cloudflare Turnstile — bot protection on signup (dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
# Super-admin PIN — second factor required after login to access /super-admin
SUPER_ADMIN_PIN=your_secure_pin_here
# Razorpay — live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
# Pro Monthly auto-pay plan id — run scripts/create-razorpay-pro-plan.cjs once to create it
RAZORPAY_PRO_PLAN_ID=your_razorpay_plan_id_here
# Webhook secret from Razorpay Dashboard → Settings → Webhooks (separate from the API key secret)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Set to true to enable verbose server-side logging (development only)
DEBUG=false
# Sentry — error monitoring (sentry.io → Project → Settings → Client Keys)
SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Uploaded PPTX rendering service. Set the same secret on python-ppt-api.
PPT_TEMPLATE_SERVICE_URL=https://your-ppt-service.example.com
PPT_TEMPLATE_SERVICE_SECRET=replace_with_a_long_random_secret

# ── Gamma PPT experiment (staging only; legacy renderer needs none of this) ──
# Gamma is OFF unless every gate below passes. Production must never list itself in GAMMA_ALLOWED_ENVIRONMENTS.
# GAMMA_EXPERIMENT_ENABLED=false
# GAMMA_ENVIRONMENT_NAME=staging              # explicit server-side identity; unset => Gamma disabled (fails closed)
# GAMMA_ALLOWED_ENVIRONMENTS=staging
# GAMMA_ALLOWED_SUPABASE_REFS=               # REQUIRED: project ref(s) of the staging Supabase; Gamma never runs against production
# GAMMA_TESTER_EMAILS=tester@example.com
# PPT_GENERATION_PROVIDER=legacy              # server default for authorised testers: legacy | gamma
# GAMMA_API_KEY=your_gamma_api_key_here       # server-side only; never NEXT_PUBLIC_
# GAMMA_EXPORT_HOST_ALLOWLIST=                # REQUIRED, no default: Gamma documents no export host. Exact hosts, or *.suffix
# NEXT_PUBLIC_GAMMA_EXPERIMENT=false          # lets the UI ask the server whether to show the toggle; the server still enforces access
# Requires migration supabase/migrations/20261022120000_gamma_generations.sql (service-role ledger) and SUPABASE_SERVICE_ROLE_KEY.
# GAMMA_THEME_ID=                             # optional; list with GET https://public-api.gamma.app/v1.0/themes
# GAMMA_IMAGE_SOURCE=aiGenerated
# GAMMA_IMAGE_MODEL=                          # optional; unset = Gamma chooses (cost unknown until observed)
# GAMMA_IMAGE_STYLE=
# Timeouts (ms): one HTTP call / one polling window / whole invocation (keep below the 180s route limit)
# GAMMA_REQUEST_TIMEOUT_MS=20000
# GAMMA_POLL_TIMEOUT_MS=120000
# GAMMA_OVERALL_BUDGET_MS=160000
# Limits (persistent, per ledger)
# GAMMA_MAX_CARDS_PER_RUN=25
# GAMMA_MAX_CREDITS_PER_RUN=300
# GAMMA_ESTIMATED_CREDITS_PER_RUN=300         # charged against budgets for in-flight/unknown runs and the run being admitted
# GAMMA_USER_HOURLY_LIMIT=3
# GAMMA_USER_DAILY_LIMIT=10
# GAMMA_DAILY_CREDIT_BUDGET=1000
# GAMMA_MONTHLY_CREDIT_BUDGET=5000
# GAMMA_UNKNOWN_QUARANTINE_MS=1800000         # block re-submission after a create call with unknown outcome
# GAMMA_STALE_ACTIVE_MS=7200000
# EXPERIMENT_ALLOWED_FEATURES=home,auth,dashboard,lesson-plan,lesson-plan-docx,lesson-plan-pptx,lesson-plan-zip,my-lesson-plans,settings,super-admin,user-usage,environment-check

# DeepSeek cost estimates only (USD per 1M tokens; official pricing can change)
# DEEPSEEK_CACHE_HIT_USD_PER_MILLION=0.006
# DEEPSEEK_CACHE_MISS_USD_PER_MILLION=0.3
# DEEPSEEK_OUTPUT_USD_PER_MILLION=1.2
