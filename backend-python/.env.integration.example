# Local-only Supabase RLS integration test template.
# Do not copy hosted production credentials into these variables.

RUN_SUPABASE_INTEGRATION_TESTS=1
ALLOW_SUPABASE_INTEGRATION_MUTATIONS=1
SUPABASE_INTEGRATION_ENVIRONMENT=local
SUPABASE_INTEGRATION_URL=http://127.0.0.1:54321
SUPABASE_INTEGRATION_ANON_KEY=<local-anon-key>
SUPABASE_INTEGRATION_SERVICE_ROLE_KEY=<local-service-role-key>
