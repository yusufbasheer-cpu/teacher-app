DEEPSEEK_API_KEY=your_deepseek_api_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only — for user_usage increments when RLS blocks anon JWT updates (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Pexels — one line only; key from https://www.pexels.com/api/ (not a URL)
PEXELS_API_KEY=your_pexels_api_key_here
# fal.ai — format id:secret from https://fal.ai/dashboard/keys
FAL_API_KEY=your_fal_api_key_here
# SMTP — Hostinger (port 587, STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_USER=info@layah.in
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=info@layah.in
# Cloudflare Turnstile — bot protection on signup (dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
# Super-admin PIN — second factor required after login to access /super-admin
SUPER_ADMIN_PIN=your_secure_pin_here
# Razorpay — live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
# Pro Monthly auto-pay plan id — run scripts/create-razorpay-pro-plan.cjs once to create it
RAZORPAY_PRO_PLAN_ID=your_razorpay_plan_id_here
# Webhook secret from Razorpay Dashboard → Settings → Webhooks (separate from the API key secret)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Set to true to enable verbose server-side logging (development only)
DEBUG=false
# Sentry — error monitoring (sentry.io → Project → Settings → Client Keys)
SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
